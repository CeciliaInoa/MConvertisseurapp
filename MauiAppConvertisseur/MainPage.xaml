<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppConvertisseur.MainPage"
             Title="Convertisseur" >

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="22"
            VerticalOptions="Center"
            HorizontalOptions="Center">
            <Image
                Source="temperature.png"
                HeightRequest="90"
                HorizontalOptions="Center" 
                />
                

            <Label
                Text="Bienvenue au EasyConverter"
                FontSize="30"
                TextColor="DeepSkyBlue"
                HorizontalOptions="Center"
                VerticalOptions="Center"/>

            <Label
                Text="Conversion en degré Celsius et Fahrenheit"
                FontSize="20"
                TextColor="MidnightBlue"
                HorizontalOptions="Center"
                VerticalOptions="Center"/>

            <Grid Padding="0,10"
                  RowSpacing="10"
                  ColumnSpacing="10"
                  HorizontalOptions="Center"
                  VerticalOptions="Center">
                
                <Grid.RowDefinitions>
                    <RowDefinition Height="50" />
                    <RowDefinition Height="50" />
                </Grid.RowDefinitions>
                
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                
                <Entry Grid.Column="0" Grid.Row="0"
                        x:Name="celEntry"
                        Placeholder="Tapez ⁰C"
                        WidthRequest="130"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"/>

                <Entry Grid.Column="0" Grid.Row="1"
                        x:Name="fahEntry"
                        Placeholder="Tapez ⁰F"
                        WidthRequest="130"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"/>
                       

                <ImageButton Grid.Column="1" Grid.Row="0"
                             Source="arrow.png"
                             Margin="3"
                             HeightRequest="30"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Clicked="Button_Clicked_CF"/>
                
                <ImageButton Grid.Column="1" Grid.Row="1"
                             Source="arrow.png"
                             Margin="3"
                             HeightRequest="30"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Clicked="Button_Clicked_FC"/>

                <Label Grid.Column="2" Grid.Row="0" 
                       Text="⁰F" 
                       FontSize="24"
                       TextColor="MidnightBlue"
                       VerticalOptions="Center"
                       VerticalTextAlignment="Center"
                       HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"/>
                       

                <Label Grid.Column="2" Grid.Row="1" 
                       Text="⁰C" 
                       FontSize="24" 
                       TextColor="MidnightBlue" 
                       VerticalTextAlignment="Center"
                       VerticalOptions="Center"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"/>

            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

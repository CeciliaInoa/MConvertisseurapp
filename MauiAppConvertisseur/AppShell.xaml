<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MauiAppConvertisseur.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MauiAppConvertisseur"
    Shell.FlyoutBehavior="Flyout"
    >

   


    <FlyoutItem Title="Convertisseur" Icon="converter.jpg">
        <ShellContent Title="Convertisseur"
                      ContentTemplate="{DataTemplate local:MainPage}" />
    </FlyoutItem>
    
    
     <FlyoutItem Title="À propos" Icon="info.png">
        <ShellContent Title="À propos"
                      ContentTemplate="{DataTemplate local:NewPage1}" />
    </FlyoutItem>

    <Shell.FlyoutHeader>
        <StackLayout BackgroundColor="DeepSkyBlue" Padding="10 ">
            <Label Text="Bienvenue!" TextColor="WhiteSmoke" FontSize="Large" VerticalTextAlignment="Center" HorizontalTextAlignment="Center"/>
        </StackLayout>
    </Shell.FlyoutHeader>
    <Shell.FlyoutFooter>
        <StackLayout BackgroundColor="DeepSkyBlue" Padding="5 ">
            <Label Text="EasyConverter" TextColor="WhiteSmoke"  FontSize="Small" VerticalTextAlignment="Center" HorizontalTextAlignment="Center" />
            <Label Text="2024 © Cecilia Inoa" TextColor="WhiteSmoke"  FontSize="Small" VerticalTextAlignment="Center" HorizontalTextAlignment="Center"/>
        </StackLayout>
    </Shell.FlyoutFooter>
    
    
</Shell>

